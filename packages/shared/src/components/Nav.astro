---
import { SITE, NAV } from "../index.js"
---

<header class="bg-paper/80 backdrop-blur-sm sticky top-0 z-50 border-b border-black/5">
  <nav class="sc-container flex items-center justify-between py-5">
    <a href="/" class="font-serif text-2xl text-ink no-underline tracking-tight">
      {SITE.name}
    </a>
    <ul class="flex items-center gap-6 list-none m-0 p-0 text-sm">
      {NAV.map((item) => (
        <li>
          <a href={item.href} class="text-ink-muted hover:text-ink transition-colors no-underline">
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>
