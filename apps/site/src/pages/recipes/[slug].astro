---
import Layout from "../../layouts/Layout.astro"
import { recipes, getRecipe } from "../../data/recipes.ts"

export function getStaticPaths() {
  return recipes.map((recipe) => ({ params: { slug: recipe.slug } }))
}

const { slug } = Astro.params
const recipe = getRecipe(slug!)

if (!recipe) {
  throw new Error(`Recipe not found: ${slug}`)
}

const primitiveLabel: Record<string, string> = {
  browser: "Browser",
  sandbox: "Sandbox",
  desktop: "Desktop",
}
---

<Layout title={`${recipe.title} — Scudra`} description={recipe.tagline}>
  <article class="sc-container" style="padding-block: 5rem; max-width: 68ch;">
    <p style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.12em; color: var(--sc-ink-muted); margin-bottom: 1rem;">
      <a href="/recipes" style="text-decoration: none; color: inherit;">← Recipes</a>
    </p>

    <div style="display: flex; gap: 0.5rem; margin-bottom: 1rem; flex-wrap: wrap;">
      {recipe.primitives.map((p) => (
        <span style="font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.08em; padding: 0.25rem 0.6rem; background: var(--sc-ink); color: var(--sc-paper); border-radius: 999px;">
          {primitiveLabel[p]}
        </span>
      ))}
    </div>

    <h1 style="font-family: var(--sc-font-serif); font-size: clamp(2rem, 5vw, 3rem); line-height: 1.1; letter-spacing: -0.02em; margin-bottom: 1rem;">
      {recipe.title}
    </h1>
    <p style="font-size: 1.125rem; color: var(--sc-ink-muted); line-height: 1.6; margin-bottom: 2rem;">
      {recipe.description}
    </p>

    {recipe.status === "live" && recipe.demo && (
      <a
        href={recipe.demo}
        style="display: inline-block; padding: 0.75rem 1.25rem; background: var(--sc-accent); color: white; border-radius: var(--sc-radius); text-decoration: none; font-weight: 500; margin-right: 0.75rem;"
      >
        Try the experience
      </a>
    )}
    {recipe.source && (
      <a
        href={`https://github.com/scudra/scudra/tree/main/${recipe.source}`}
        style="display: inline-block; padding: 0.75rem 1.25rem; border: 1px solid rgba(0,0,0,0.1); border-radius: var(--sc-radius); text-decoration: none; color: var(--sc-ink);"
      >
        View source
      </a>
    )}
  </article>
</Layout>
