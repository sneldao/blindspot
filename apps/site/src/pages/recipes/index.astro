---
import Layout from "../../layouts/Layout.astro"
import { recipes } from "../../data/recipes.ts"

const primitiveLabel: Record<string, string> = {
  browser: "Browser",
  sandbox: "Sandbox",
  desktop: "Desktop",
}
---

<Layout title="Recipes — Scudra" description="A collection of cloud agent recipes.">
  <section class="sc-container" style="padding-block: 5rem;">
    <p style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.12em; color: var(--sc-ink-muted); margin-bottom: 1rem;">
      Recipes
    </p>
    <h1 style="font-family: var(--sc-font-serif); font-size: clamp(2.25rem, 5vw, 3.5rem); line-height: 1.1; letter-spacing: -0.02em; margin-bottom: 1rem;">
      Cloud agent recipes
    </h1>
    <p style="color: var(--sc-ink-muted); max-width: 55ch; margin-bottom: 3rem; line-height: 1.6;">
      Each recipe is a real, runnable agent. Study it, fork it, and adapt it to your own work.
    </p>

    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 1.5rem;">
      {recipes.map((recipe) => (
        <a
          href={`/recipes/${recipe.slug}`}
          style="display: block; padding: 1.5rem; background: var(--sc-paper-warm); border-radius: var(--sc-radius); border: 1px solid rgba(0,0,0,0.06); text-decoration: none; color: inherit;"
        >
          <div style="display: flex; gap: 0.5rem; margin-bottom: 0.75rem; flex-wrap: wrap;">
            {recipe.primitives.map((p) => (
              <span style="font-size: 0.65rem; text-transform: uppercase; letter-spacing: 0.08em; padding: 0.2rem 0.5rem; background: var(--sc-ink); color: var(--sc-paper); border-radius: 999px;">
                {primitiveLabel[p]}
              </span>
            ))}
          </div>
          <h2 style="font-family: var(--sc-font-serif); font-size: 1.35rem; margin-bottom: 0.5rem;">{recipe.title}</h2>
          <p style="color: var(--sc-ink-muted); line-height: 1.5; font-size: 0.95rem;">{recipe.tagline}</p>
          <span style="display: inline-block; margin-top: 1rem; font-size: 0.85rem; color: var(--sc-accent); font-weight: 500;">
            Read recipe →
          </span>
        </a>
      ))}
    </div>
  </section>
</Layout>
